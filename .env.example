# ══════════════════════════════════════════════════════════════════
# .env.example — Copia este archivo como .env y rellena los valores
# NUNCA subas el .env real al repositorio
# ══════════════════════════════════════════════════════════════════

# ── Keycloak ──────────────────────────────────────────────────────
KEYCLOAK_URL=https://sso.hro.gob.gt
KEYCLOAK_REALM=Hospital-O
KEYCLOAK_CLIENT_ID=sistema-actas
KEYCLOAK_CLIENT_SECRET=REEMPLAZAR_CON_SECRET_REAL
KEYCLOAK_FRONTEND_CLIENT_UUID=REEMPLAZAR_CON_UUID_DEL_CLIENT

# ── API de Recursos Humanos ───────────────────────────────────────
RH_API_URL=https://asistencia.hro.gob.gt
# true = usa datos mock (útil en dev si Cloudflare bloquea)
RH_API_USE_MOCK=true

# ── Base de datos (solo si el backend corre fuera de Docker) ──────
# En Docker estos valores ya están definidos en docker-compose.yml
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3308/renap_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Guatemala
DB_USERNAME=renap_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_REAL

# ── Frontend Keycloak client ──────────────────────────────────────
VITE_KEYCLOAK_CLIENT=sistema-actas-frontend
