# ── Keycloak SSO ──────────────────────────────────────────────────────────────
# Copiar como .env.local para desarrollo o inyectar en el Dockerfile para producción.

# URL base del servidor Keycloak
VITE_KEYCLOAK_URL=https://sso.hro.gob.gt

# Realm donde están los usuarios del hospital
VITE_KEYCLOAK_REALM=Hospital-O

# Client ID del frontend (debe tener Access Type = public y Valid Redirect URIs configuradas)
VITE_KEYCLOAK_CLIENT=sistema-actas-frontend

# URL base del backend Spring Boot (sin /api al final)
# En producción Docker la red interna resuelve esto automáticamente
VITE_API_URL=/api
