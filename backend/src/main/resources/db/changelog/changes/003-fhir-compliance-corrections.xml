        <modifyDataType tableName="informe_defuncion" columnName="info_quien_informa_nombres" newDataType="VARCHAR(255)"/>
        <modifyDataType tableName="informe_defuncion" columnName="info_documento_identificacion" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="info_no_colegiado" newDataType="VARCHAR(50)"/>
        <modifyDataType tableName="informe_defuncion" columnName="info_lugar_direccion" newDataType="VARCHAR(255)"/>
        <modifyDataType tableName="informe_defuncion" columnName="info_lugar_municipio" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="info_lugar_departamento" newDataType="VARCHAR(100)"/>
        
        <!-- Sección II: Datos del fallecido -->
