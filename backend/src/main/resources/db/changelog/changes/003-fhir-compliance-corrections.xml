        <!-- CRÍTICO: Cambiar gestación mortinato de INTEGER a DECIMAL para cumplir FHIR -->
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_semanas_gestacion" newDataType="DECIMAL(4,3)"/>
    </changeSet>

</databaseChangeLog>