        <!-- Sección IV: Causa de defunción (intervalos) -->
        <modifyDataType tableName="informe_defuncion" columnName="causa_i_a_intervalo" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="causa_i_b_intervalo" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="causa_i_c_intervalo" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="causa_i_d_intervalo" newDataType="VARCHAR(100)"/>
        
        <!-- Sección V: Defunciones accidentales -->
        <modifyDataType tableName="informe_defuncion" columnName="accidental_arma_produjo" newDataType="VARCHAR(255)"/>
        
        <!-- Sección VI: Mortinato - Datos de la madre -->
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_nombre" newDataType="VARCHAR(255)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_doc_numero" newDataType="VARCHAR(13)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_doc_libro" newDataType="VARCHAR(50)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_doc_folio" newDataType="VARCHAR(50)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_doc_partida" newDataType="VARCHAR(50)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_lugar_nac_pais" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_lugar_nac_departamento" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_lugar_nac_municipio" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_residencia_direccion" newDataType="VARCHAR(255)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_residencia_municipio" newDataType="VARCHAR(100)"/>
        <modifyDataType tableName="informe_defuncion" columnName="mortinato_madre_residencia_departamento" newDataType="VARCHAR(100)"/>
